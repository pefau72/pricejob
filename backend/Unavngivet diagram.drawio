        <mxCell id="6WGrhbhOTThPKOeT--B7-23" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div style=&quot;line-height: 110%;&quot;&gt;&lt;li class=&quot;text-ink-primary text-t2 py-1 leading-6 [&amp;amp;&amp;gt;p]:inline&quot;&gt;&lt;span class=&quot;font-semibold&quot;&gt;Modtager et kald&lt;/span&gt; — &lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;GET /api/prices?area=DK2&lt;/code&gt;.&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;text-ink-primary text-t2 py-1 leading-6 [&amp;amp;&amp;gt;p]:inline&quot;&gt;&lt;span class=&quot;font-semibold&quot;&gt;Læser snapshot&#39;et&lt;/span&gt; fra Blob.&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;text-ink-primary text-t2 py-1 leading-6 [&amp;amp;&amp;gt;p]:inline&quot;&gt;&lt;span class=&quot;font-semibold&quot;&gt;Svarer med JSON&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;text-ink-primary text-t2 py-1 leading-6 [&amp;amp;&amp;gt;p]:inline&quot;&gt;Sætter et cache-hoved&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; så browseren og eventuelle mellemliggende caches ved, at svaret gerne må genbruges i fx fem minutter.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
